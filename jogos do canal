let activeTab = 0;

function renderTabs() {
  const container = document.getElementById('tabsContainer');
  container.innerHTML = database.map((cat, idx) => `
    <button class="tab ${idx === activeTab ? 'active' : ''}" onclick="switchTab(${idx})">
      ${cat.category}
    </button>
  `).join('');
}

function switchTab(idx) {
  activeTab = idx;
  document.getElementById('searchInput').value = '';
  renderTabs();
  renderGames(database[activeTab].items);
}

function renderGames(items) {
  const listContainer = document.getElementById('gameListContainer');
  if (items.length === 0) {
    listContainer.innerHTML = `<div class="empty-state">Nenhum jogo encontrado 🕵️‍♂️</div>`;
    return;
  }
  
  listContainer.innerHTML = items.map((game, i) => `
    <div class="game-card">
      <div class="game-info">
        <div class="game-name">${game.name}</div>
        <div class="game-command">${game.command}</div>
      </div>
      <button class="copy-btn" onclick="copyCommand('${escapeHtml(game.command)}', this)">
        📋 Copiar
      </button>
    </div>
  `).join('');
}

function filterGames() {
  const query = document.getElementById('searchInput').value.toLowerCase().trim();
  if (!query) {
    renderGames(database[activeTab].items);
    return;
  }

  let allMatches = [];
  database.forEach(cat => {
    cat.items.forEach(game => {
      if (game.name.toLowerCase().includes(query) || game.command.toLowerCase().includes(query)) {
        allMatches.push(game);
      }
    });
  });

  renderGames(allMatches);
}

function copyCommand(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const originalText = btn.innerHTML;
    btn.innerHTML = '✅ Copiado!';
    btn.classList.add('copied');
    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.classList.remove('copied');
    }, 1500);
  });
}

function escapeHtml(str) {
  return str.replace(/'/g, "\\'").replace(/"/g, '&quot;');
}

// Inicializar página
renderTabs();
renderGames(database[0].items);
